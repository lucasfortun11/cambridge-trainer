# Copy this file to .env and fill in real values. Never commit .env itself
# (already gitignored) — it holds live secrets once filled in.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL is required — SQLite doesn't survive serverless hosting (Vercel
# etc. have a read-only/ephemeral filesystem at runtime).
#
# Local dev: `docker compose up -d` starts one for you at this URL — use the
# same value for both vars below, there's no pooler to worry about locally.
#
# Production with Supabase: Project Settings > Database > Connect > "ORMs"
# tab > Prisma preset gives you both of these directly.
#   DATABASE_URL = the "Transaction pooler" URL, port 6543, with
#                   ?pgbouncer=true — used by the app at runtime.
#   DIRECT_URL   = the direct connection URL, port 5432, no pooler — used
#                   only when running `prisma migrate`.
DATABASE_URL="postgresql://cambridge:cambridge@localhost:5434/cambridge_trainer"
DIRECT_URL="postgresql://cambridge:cambridge@localhost:5434/cambridge_trainer"

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Session cookie signing secret. Generate a real one for every environment —
# never reuse the same value across dev/prod, and never commit a real value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# App URL (required in production if using Stripe)
# ---------------------------------------------------------------------------
# Your deployed URL, no trailing slash. Server-only — used to build Stripe's
# success/cancel redirect URLs. Falls back to http://localhost:3000 if unset.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI provider (optional — the app runs fully offline without this)
# ---------------------------------------------------------------------------
# Leave unset (or "mock") to use the built-in deterministic mock provider —
# real content, zero cost, no API key needed, but not genuinely AI-generated.
AI_PROVIDER="mock"
# DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-chat"

# ---------------------------------------------------------------------------
# Stripe (optional — the app runs in "demo billing" mode without this: the
# pricing page still works, but "subscribing" just flips a flag in the
# database with a clearly-labelled fake card form, no real payment gateway)
# ---------------------------------------------------------------------------
# To take real payments: create a Stripe account, then in the Dashboard
# create two Products with a recurring Price each (Monthly / Annual) — see
# README "Despliegue a producción" for the exact prices this app expects —
# and paste their IDs below. Get the secret key from Developers > API keys,
# and the webhook secret after creating the webhook endpoint (see README).
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID_MONTHLY=""
# STRIPE_PRICE_ID_ANNUAL=""
